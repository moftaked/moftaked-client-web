{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "appData": {
    "version": "0.2.0"
  },
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.json",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ],

  "dataGroups": [
    {
      "name": "classes",
      "urls": [
        "users/*/classes"
      ],
      "cacheConfig": {
        "maxSize": 1,
        "maxAge": "14d",
        "timeout": "5s"
      }
    },
    {
      "name": "class details",
      "urls": [
        "classes/*"
      ],
      "cacheConfig": {
        "maxSize": 100,
        "maxAge": "14d",
        "timeout": "5s",
        "strategy": "freshness"
      }
    }
  ]
}
